<Window x:Class="Lobster.JobsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Lobster"
        Title="{l:Tr Fr='Lobster — Activité', En='Lobster — Activity'}" Width="400" SizeToContent="Height" MaxHeight="460"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Text, Segoe UI" UseLayoutRounding="True">
    <Border Margin="12" CornerRadius="12" Background="#F51A1A1D" BorderBrush="#33FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.45"/>
        </Border.Effect>
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="14,10,8,6">
                <Image Source="pack://application:,,,/Assets/lobster.png" Width="18" Height="18" VerticalAlignment="Center"/>
                <TextBlock Text="Lobster" Foreground="{StaticResource Text}" FontWeight="SemiBold" FontSize="13"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource GhostButton}" Click="OnClear" ToolTip="{l:Tr Fr='Effacer les tâches terminées', En='Clear finished tasks'}" Content="{l:Tr Fr='Effacer', En='Clear'}"/>
                    <Button Style="{StaticResource GhostButton}" Click="OnClose" ToolTip="{l:Tr Fr='Masquer', En='Hide'}">
                        <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="11"/>
                    </Button>
                </StackPanel>
            </DockPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,4,8">
                <ItemsControl x:Name="List" Margin="10,0,6,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,6" Padding="12,9" CornerRadius="9" Background="#26FFFFFF">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="StateIcon" Text="{Binding StateGlyph}" Style="{StaticResource Icon}" FontSize="15"
                                               VerticalAlignment="Top" Margin="0,2,11,0" Foreground="{StaticResource TextDim}"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource Text}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <ProgressBar Margin="0,7,0,1" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}"
                                                     IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}"
                                                     Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"/>
                                        <TextBox Text="{Binding Error, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontSize="12"
                                                 Margin="0,6,0,0" Padding="7,5" MaxHeight="96" VerticalScrollBarVisibility="Auto"
                                                 Foreground="{StaticResource Danger}" Background="#22F0645A" BorderThickness="0"
                                                 Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="6,-2,-4,0">
                                        <Button Style="{StaticResource GhostButton}" ToolTip="{l:Tr Fr='Afficher dans l’Explorateur', En='Show in Explorer'}" Click="OnReveal"
                                                Visibility="{Binding HasOutputs, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="&#xE838;" Style="{StaticResource Icon}" FontSize="13"/>
                                        </Button>
                                        <Button Style="{StaticResource GhostButton}" ToolTip="{l:Tr Fr='Ouvrir', En='Open'}" Click="OnOpen"
                                                Visibility="{Binding HasOutputs, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="13"/>
                                        </Button>
                                        <Button Style="{StaticResource GhostButton}" ToolTip="{l:Tr Fr='Annuler', En='Cancel'}" Click="OnCancel"
                                                Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="12"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="Done">
                                    <Setter TargetName="StateIcon" Property="Foreground" Value="{StaticResource Ok}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Failed">
                                    <Setter TargetName="StateIcon" Property="Foreground" Value="{StaticResource Danger}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Running">
                                    <Setter TargetName="StateIcon" Property="Foreground" Value="{StaticResource Accent}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
