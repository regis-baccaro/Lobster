<Window x:Class="Lobster.TrimWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Lobster"
        Title="{l:Tr Fr='Découper — Lobster', En='Trim — Lobster'}" Width="900" Height="640" MinWidth="620" MinHeight="420">
    <Grid Margin="18,14,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="#0D0D0F" CornerRadius="10" ClipToBounds="True">
            <Grid>
                <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Close"
                              ScrubbingEnabled="True" Stretch="Uniform" Volume="0.8"/>
                <StackPanel x:Name="NoPreview" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="NoPreviewGlyph" Text="&#xE8D6;" Style="{StaticResource Icon}" FontSize="44"
                               Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="NoPreviewText" Style="{StaticResource Dim}" Margin="0,10,0,0" TextAlignment="Center" MaxWidth="420"/>
                </StackPanel>
            </Grid>
        </Border>

        <Canvas x:Name="Track" Grid.Row="1" Height="48" Margin="0,16,0,0" Background="Transparent" Cursor="Hand" ClipToBounds="False"/>

        <WrapPanel Grid.Row="2" Margin="0,12,0,0" VerticalAlignment="Center">
            <Button x:Name="PlayButton" Click="OnPlay" MinWidth="44" Padding="10,6" Margin="0,0,10,6" ToolTip="{l:Tr Fr='Lire la sélection (Espace)', En='Play the selection (Space)'}">
                <TextBlock x:Name="PlayGlyph" Text="&#xE768;" Style="{StaticResource Icon}" FontSize="14"/>
            </Button>
            <TextBlock x:Name="Clock" Text="0:00.0" VerticalAlignment="Center" Margin="0,0,22,6" FontFamily="Consolas" FontSize="14"/>

            <TextBlock Text="{l:Tr Fr='Début', En='Start'}" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,8,6"/>
            <TextBox x:Name="StartBox" Width="104" Margin="0,0,6,6" FontFamily="Consolas"/>
            <Button Content="{l:Tr Fr='⟦ Ici', En='⟦ Here'}" Style="{StaticResource ChipButton}" Click="OnStartHere" Margin="0,0,18,6" ToolTip="{l:Tr Fr='Début = position actuelle', En='Start = current position'}"/>

            <TextBlock Text="{l:Tr Fr='Fin', En='End'}" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,8,6"/>
            <TextBox x:Name="EndBox" Width="104" Margin="0,0,6,6" FontFamily="Consolas"/>
            <Button Content="{l:Tr Fr='Ici ⟧', En='Here ⟧'}" Style="{StaticResource ChipButton}" Click="OnEndHere" Margin="0,0,0,6" ToolTip="{l:Tr Fr='Fin = position actuelle', En='End = current position'}"/>
        </WrapPanel>

        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <CheckBox x:Name="FastBox" VerticalAlignment="Center"
                      ToolTip="{l:Tr Fr='Instantané et sans perte, mais la coupe se cale sur l’image clé la plus proche.', En='Instant and lossless, but the cut snaps to the nearest keyframe.'}">
                <TextBlock Text="{l:Tr Fr='Rapide (sans réencodage)', En='Fast (no re-encoding)'}"/>
            </CheckBox>
            <TextBlock x:Name="Summary" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="18,0,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{l:Tr Fr='Annuler', En='Cancel'}" IsCancel="True" Margin="0,0,8,0"/>
                <Button Content="{l:Tr Fr='Découper', En='Trim'}" Style="{StaticResource AccentButton}" IsDefault="True" Click="OnApply"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
