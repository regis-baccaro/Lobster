<Window x:Class="Lobster.CropWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Lobster"
        Title="{l:Tr Fr='Rogner — Lobster', En='Crop — Lobster'}" Width="960" Height="720" MinWidth="620" MinHeight="460">
    <Grid Margin="18,14,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,12">
            <TextBlock DockPanel.Dock="Left" Text="{l:Tr Fr='Format', En='Ratio'}" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <StackPanel x:Name="Ratios" Orientation="Horizontal"/>
            <TextBlock x:Name="Note" Style="{StaticResource Dim}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </DockPanel>

        <Border Grid.Row="1" Background="#0D0D0F" CornerRadius="10" ClipToBounds="True">
            <Grid x:Name="Host" Margin="16">
                <Canvas x:Name="Board" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent" Cursor="Cross">
                    <Image x:Name="Pic" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Path x:Name="Shade" Fill="#A6000000" IsHitTestVisible="False"/>
                    <Canvas x:Name="Thirds" IsHitTestVisible="False"/>
                    <Rectangle x:Name="Frame" Stroke="White" StrokeThickness="1.5" IsHitTestVisible="False"/>
                    <Canvas x:Name="Handles" IsHitTestVisible="False"/>
                </Canvas>
            </Grid>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="SizeLabel" Style="{StaticResource Dim}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{l:Tr Fr='Réinitialiser', En='Reset'}" Style="{StaticResource GhostButton}" Click="OnReset" Margin="0,0,8,0"/>
                <Button Content="{l:Tr Fr='Annuler', En='Cancel'}" IsCancel="True" Margin="0,0,8,0"/>
                <Button Content="{l:Tr Fr='Rogner', En='Crop'}" Style="{StaticResource AccentButton}" IsDefault="True" Click="OnApply"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
