<Window x:Class="Lobster.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Lobster"
        Title="{l:Tr Fr='Lobster — Paramètres', En='Lobster — Settings'}" Width="640" Height="800" MinWidth="540" MinHeight="480">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" Padding="22,12">
            <DockPanel>
                <TextBlock x:Name="Version" Style="{StaticResource Dim}" VerticalAlignment="Center"/>
                <Button Content="{l:Tr Fr='Fermer', En='Close'}" Style="{StaticResource AccentButton}" HorizontalAlignment="Right" Click="OnClose" IsCancel="True"/>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="26,20,26,24">

                <!-- Header -->
                <DockPanel Margin="0,0,0,18">
                    <Image Source="pack://application:,,,/Assets/lobster.png" Width="52" Height="52" DockPanel.Dock="Left" Margin="0,0,16,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Lobster" FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="{l:Tr Fr='Convertir et retoucher vos fichiers sans quitter l’Explorateur.', En='Convert and edit your files without leaving Explorer.'}" Style="{StaticResource Dim}"/>
                    </StackPanel>
                </DockPanel>

                <Border x:Name="Welcome" Background="#26E8452C" BorderBrush="#66E8452C" BorderThickness="1" CornerRadius="10"
                        Padding="16,12" Margin="0,0,0,20" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="{l:Tr Fr='Bienvenue !', En='Welcome!'}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock x:Name="WelcomeText" TextWrapping="Wrap" Foreground="{StaticResource Text}"/>
                    </StackPanel>
                </Border>

                <!-- Language -->
                <TextBlock Text="{l:Tr Fr='Langue', En='Language'}" Style="{StaticResource Heading}"/>
                <WrapPanel>
                    <RadioButton x:Name="LangFr" GroupName="lang" Content="Français"/>
                    <RadioButton x:Name="LangEn" GroupName="lang" Content="English"/>
                </WrapPanel>

                <!-- Palette -->
                <TextBlock Text="{l:Tr Fr='Couleurs du menu radial', En='Radial menu colors'}" Style="{StaticResource Heading}" Margin="0,22,0,8"/>
                <WrapPanel x:Name="PaletteList"/>
                <DockPanel Margin="0,6,0,0">
                    <Button DockPanel.Dock="Right" Content="{l:Tr Fr='Aperçu', En='Preview'}" Click="OnPreview" Margin="8,0,0,0"/>
                    <TextBlock Text="{l:Tr Fr='Couleur personnalisée', En='Custom color'}" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Border x:Name="CustomSwatch" Width="26" Height="26" CornerRadius="13" Margin="0,0,10,0" BorderBrush="#55FFFFFF" BorderThickness="1"/>
                    <TextBox x:Name="CustomHex" Width="110" HorizontalAlignment="Left" FontFamily="Consolas" ToolTip="#RRGGBB"/>
                </DockPanel>

                <!-- Gesture -->
                <TextBlock Text="{l:Tr Fr='Geste', En='Gesture'}" Style="{StaticResource Heading}" Margin="0,22,0,8"/>
                <CheckBox x:Name="GestureOn" Content="{l:Tr Fr='Ouvrir le menu quand je glisse des fichiers en maintenant une touche', En='Open the menu when I drag files while holding a key'}"/>
                <TextBlock Text="{l:Tr Fr='Touche', En='Key'}" Style="{StaticResource Dim}" Margin="0,12,0,6"/>
                <WrapPanel>
                    <RadioButton x:Name="KeyShift" GroupName="key" Content="{l:Tr Fr='Maj (Shift)', En='Shift'}"/>
                    <RadioButton x:Name="KeyCtrl" GroupName="key" Content="Ctrl"/>
                    <RadioButton x:Name="KeyAlt" GroupName="key" Content="Alt"/>
                </WrapPanel>
                <TextBlock Text="{l:Tr Fr='Maj est le geste d’origine. Ctrl est plus sûr : si vous relâchez à côté du menu, l’Explorateur copie au lieu de déplacer.', En='Shift is the original gesture. Ctrl is safer: if you release outside the menu, Explorer copies instead of moving.'}"
                           Style="{StaticResource Dim}" FontSize="12"/>
                <TextBlock Text="{l:Tr Fr='Où', En='Where'}" Style="{StaticResource Dim}" Margin="0,12,0,6"/>
                <WrapPanel>
                    <RadioButton x:Name="ScopeExplorer" GroupName="scope" Content="{l:Tr Fr='Explorateur et Bureau', En='Explorer and Desktop'}"/>
                    <RadioButton x:Name="ScopeAll" GroupName="scope" Content="{l:Tr Fr='Partout (navigateur, Outlook…)', En='Everywhere (browser, Outlook…)'}"/>
                </WrapPanel>

                <!-- Output -->
                <TextBlock Text="{l:Tr Fr='Fichiers créés', En='Created files'}" Style="{StaticResource Heading}" Margin="0,22,0,8"/>
                <WrapPanel>
                    <RadioButton x:Name="OutSame" GroupName="out" Content="{l:Tr Fr='À côté de l’original', En='Next to the original'}"/>
                    <RadioButton x:Name="OutSub" GroupName="out" Content="{l:Tr Fr='Sous-dossier « Lobster »', En='“Lobster” subfolder'}"/>
                    <RadioButton x:Name="OutCustom" GroupName="out" Content="{l:Tr Fr='Dossier choisi', En='Chosen folder'}"/>
                </WrapPanel>
                <DockPanel x:Name="CustomRow" Margin="0,4,0,0">
                    <Button DockPanel.Dock="Right" Content="{l:Tr Fr='Parcourir…', En='Browse…'}" Margin="8,0,0,0" Click="OnBrowseFolder"/>
                    <TextBox x:Name="CustomFolder" IsReadOnly="True"/>
                </DockPanel>
                <TextBlock Text="{l:Tr Fr='Lobster n’écrase jamais rien : les résultats reçoivent un nouveau nom.', En='Lobster never overwrites anything: results get a new name.'}"
                           Style="{StaticResource Dim}" FontSize="12" Margin="0,6,0,0"/>

                <!-- Windows -->
                <TextBlock Text="{l:Tr Fr='Intégration Windows', En='Windows integration'}" Style="{StaticResource Heading}" Margin="0,22,0,8"/>
                <CheckBox x:Name="Startup" Content="{l:Tr Fr='Lancer Lobster au démarrage de Windows', En='Start Lobster with Windows'}"/>
                <CheckBox x:Name="CtxMenu" Content="{l:Tr Fr='« Lobster… » dans le clic droit (Windows 11 : « Afficher plus d’options »)', En='“Lobster…” in the right-click menu (Windows 11: “Show more options”)'}"/>
                <CheckBox x:Name="SendTo" Content="{l:Tr Fr='« Envoyer vers › Lobster » (accepte plusieurs fichiers d’un coup)', En='“Send to › Lobster” (accepts many files at once)'}"/>
                <CheckBox x:Name="Notifs" Content="{l:Tr Fr='Notification quand un lot est terminé', En='Notify me when a batch is done'}"/>

                <!-- Tools -->
                <TextBlock Text="{l:Tr Fr='Moteurs (tout reste sur votre PC)', En='Engines (everything stays on your PC)'}" Style="{StaticResource Heading}" Margin="0,22,0,8"/>
                <Border Background="{StaticResource Surface}" CornerRadius="10" Padding="14,10">
                    <StackPanel x:Name="ToolList"/>
                </Border>

                <TextBlock Margin="0,22,0,0" Style="{StaticResource Dim}" FontSize="12">
                    <Hyperlink Click="OnOpenLog" Foreground="{StaticResource TextDim}"><Run Text="{l:Tr Fr='Journal', En='Log'}"/></Hyperlink>
                    <Run Text="  ·  "/>
                    <Hyperlink Click="OnUninstall" Foreground="{StaticResource TextDim}"><Run Text="{l:Tr Fr='Retirer Lobster de Windows', En='Remove Lobster from Windows'}"/></Hyperlink>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
